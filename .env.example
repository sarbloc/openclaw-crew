# ═══════════════════════════════════════════════════════════
# OpenClaw Crew — Environment Secrets
# Copy this to ~/.openclaw/.env and fill in real values.
# chmod 600 ~/.openclaw/.env
# NEVER commit the real .env — only .env.example goes in git.
# ═══════════════════════════════════════════════════════════

# ─── OpenRouter (all models route through here) ─────────
OPENROUTER_API_KEY=sk-or-CHANGEME

# ─── OpenClaw Gateway ───────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=CHANGEME_generate_with_openssl_rand_hex_32

# ─── Webhook secret (for task board hooks) ──────────────
OPENCLAW_HOOKS_TOKEN=CHANGEME_generate_with_openssl_rand_hex_32

# ─── Channels ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef_CHANGEME
# WHATSAPP_TOKEN=CHANGEME  # uncomment if using WhatsApp

# ─── Google Workspace (for Brand agent) ─────────────────
GOG_KEYRING_PASSWORD=CHANGEME
GOG_ACCOUNT=your-email@gmail.com

# ─── Optional: other service keys ───────────────────────
# BRAVE_SEARCH_API_KEY=CHANGEME
# ELEVENLABS_API_KEY=CHANGEME

# ─── Entity Memory (Qdrant) ─────────────────────────────
QDRANT_API_KEY=CHANGEME_generate_with_openssl_rand_hex_32
